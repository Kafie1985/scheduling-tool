# Copy to .env.local and fill in real values. Never commit that file.
# If any of these are missing, the dashboard still loads and booking submit stays disabled.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Square Sandbox OAuth. Set real values in .env.local or the host environment.
# SQUARE_REDIRECT_URL is the public origin plus /api/square/callback.
SQUARE_ENVIRONMENT=
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_REDIRECT_URL=
